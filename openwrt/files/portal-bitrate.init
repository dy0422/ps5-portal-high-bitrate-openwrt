#!/bin/sh /etc/rc.common
# Root's procd supervisor; no respawn while recovery may still be running.
START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled
	config_load portal_bitrate
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/portal-bitrate service
	procd_set_param stdout 1
	procd_set_param stderr 1
	# Upstream guardian can take 35 s; keep the veth alive through repair.
	procd_set_param term_timeout 90
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger portal_bitrate
}
